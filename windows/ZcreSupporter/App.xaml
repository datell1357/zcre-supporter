<Application x:Class="ZcreSupporter.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#111214" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1E22" />
    <SolidColorBrush x:Key="MutedBrush" Color="#9A9FA9" />
    <SolidColorBrush x:Key="AccentBrush" Color="#C9E9C1" />
    <Style TargetType="Window"><Setter Property="Background" Value="{StaticResource BackgroundBrush}"/><Setter Property="Foreground" Value="#F3F4F6"/><Setter Property="FontFamily" Value="Malgun Gothic"/><Setter Property="FontSize" Value="13"/></Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="#2B2E34"/><Setter Property="Foreground" Value="#F3F4F6"/><Setter Property="BorderBrush" Value="#41464F"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,6,6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#3C4149"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E6E8EC"/><Setter Property="Margin" Value="0,7"/><Setter Property="FontSize" Value="13"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#25282E"/><Setter Property="Foreground" Value="#F3F4F6"/><Setter Property="BorderBrush" Value="#474D58"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,5"/></Style>
    <Style TargetType="ScrollViewer"><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  </Application.Resources>
</Application>
